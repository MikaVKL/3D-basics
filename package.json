{
  "name": "3d-basics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "tsc && tsc -p server && vite build",
    "preview": "vite preview",
    "test:setup": "npm install --prefix tests",
    "test:stuck": "node tests/stuck-fuzz.mjs",
    "test:movement": "node tests/movement.mjs",
    "test:mp": "node tests/multiplayer.mjs",
    "test": "node tests/movement.mjs && node tests/stuck-fuzz.mjs 500 20 1 && node tests/multiplayer.mjs && node tests/sound.mjs && node tests/avatar.mjs && node tests/effects.mjs && node tests/headshot.mjs && node tests/weapons.mjs",
    "test:sound": "node tests/sound.mjs",
    "test:avatar": "node tests/avatar.mjs",
    "test:headshot": "node tests/headshot.mjs && node tests/weapons.mjs",
    "test:effects": "node tests/effects.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
